{
  "name": "@svg-jar/plugin",
  "version": "0.1.2",
  "description": "An unplugin for importing SVGs as components with sprite sheet support",
  "keywords": [
    "svg",
    "svg-jar",
    "icons",
    "sprite",
    "sprite-sheet",
    "symbol",
    "components",
    "unplugin",
    "vite",
    "vite-plugin",
    "rollup",
    "rollup-plugin",
    "rolldown",
    "esbuild",
    "webpack",
    "rspack",
    "react",
    "preact",
    "vue",
    "solid",
    "ember",
    "web-component",
    "inline-svg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/svg-jar/plugin"
  },
  "license": "MIT",
  "author": "Liam Potter <liam@liampotter.co.uk>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./vite": "./dist/vite.js",
    "./rollup": "./dist/rollup.js",
    "./rolldown": "./dist/rolldown.js",
    "./esbuild": "./dist/esbuild.js",
    "./webpack": "./dist/webpack.js",
    "./rspack": "./dist/rspack.js",
    "./runtime/dom": "./dist/runtime/dom.js",
    "./runtime/ember": "./dist/runtime/ember.js",
    "./runtime/react": "./dist/runtime/react.js",
    "./runtime/preact": "./dist/runtime/preact.js",
    "./runtime/vue": "./dist/runtime/vue.js",
    "./runtime/solid": "./dist/runtime/solid.js",
    "./runtime/web-component": "./dist/runtime/web-component.js",
    "./client/dom": {
      "types": "./client/dom.d.ts"
    },
    "./client/ember": {
      "types": "./client/ember.d.ts"
    },
    "./client/react": {
      "types": "./client/react.d.ts"
    },
    "./client/preact": {
      "types": "./client/preact.d.ts"
    },
    "./client/vue": {
      "types": "./client/vue.d.ts"
    },
    "./client/solid": {
      "types": "./client/solid.d.ts"
    },
    "./client/web-component": {
      "types": "./client/web-component.d.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "client"
  ],
  "scripts": {
    "build": "tsdown",
    "build:test-projects": "tsdown && for dir in ../test-projects/vite/*/; do (cd \"$dir\" && pnpm vite build); done",
    "dev": "tsdown --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "pnpm run sortPackageJson && pnpm run build",
    "prettier": "prettier --check .",
    "sortPackageJson": "pnpm dlx sort-package-json",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eksml/xml": "^0.2.0",
    "magic-string": "^1.1.0",
    "svgo": "^4.0.1",
    "unplugin": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "execa": "catalog:",
    "rollup": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
